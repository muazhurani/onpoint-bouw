SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@onpointgeo.nl
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="OnPoint Geomatics <info@onpointgeo.nl>"
INQUIRY_TO_EMAIL=info@onpointgeo.nl

# IMAP/POP are for receiving mail. The website forms only need SMTP to send.

# Optional. If present in /public, the sample report route attaches this PDF automatically.
# Otherwise the visitor gets a confirmation and OnPoint receives the lead.
SAMPLE_REPORT_FILE=sample-report.pdf
